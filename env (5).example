# Local dev: leave unset. Vite proxies /api to http://localhost:4000 (see vite.config.js).
#
# Production: the frontend and backend are usually deployed to two different
# hosts, so there is no dev proxy. Set this to your deployed backend's URL,
# including the /api suffix, e.g.:
# VITE_API_BASE_URL=https://saftranscriptportalbackend.onrender.com/api
VITE_API_BASE_URL=

# Supabase project — used only for student sign-up/sign-in (auth). Student
# records and transcript requests still come from the Express backend above.
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend is a Supabase Edge Function (supabase/functions/api in the backend
# repo). Set this in every environment, local dev included — there is no
# same-origin fallback anymore. Format: https://<project-ref>.supabase.co/functions/v1/api
VITE_API_BASE_URL=https://zpbzyejalapmnoovsgqs.supabase.co/functions/v1/api

# Supabase project — used only for student sign-up/sign-in (auth). Student
# records and transcript requests still come from the Express backend above.
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
